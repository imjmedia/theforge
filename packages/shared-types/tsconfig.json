{
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-cjs", "src/**/*.spec.ts", "src/**/*.test.ts", "src/**/__tests__/**", "src/design-first/__fixtures__/*.ts"]
}
